# ==============================================================================
# VertiFarm Environment Variables
# ==============================================================================
# Instructions:
# 1. Copy this file to .env or .env.local:
#    cp .env.example .env
# 2. Fill in the values below from Google Cloud Console:
#    https://console.cloud.google.com/apis/credentials
# 3. Configure the OAuth Consent Screen:
#    - User Type: External (or Internal if Google Workspace organization)
#    - Scopes: .../auth/userinfo.email, .../auth/userinfo.profile, openid
#    - Test Users: Add developer and tester email addresses if app is in Testing status
# ==============================================================================

# Backend API Configuration
# - On Web development: http://127.0.0.1:8000
# - On Physical Mobile (Expo Go on Android/iOS): http://<YOUR_COMPUTER_LAN_IP>:8000
# - If left blank in development, Expo auto-detects host machine IP on port 8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Explicit Demo / Mock Data Mode
# - Set to 'false' (default) for live FastAPI backend communication and real ML inference
# - Set to 'true' only to force offline mock data fallbacks for development demoing
EXPO_PUBLIC_DEMO_MODE=false

# ==============================================================================
# Google Cloud OAuth 2.0 Credentials
# Console: https://console.cloud.google.com/apis/credentials
# ==============================================================================

# 1. Web Client ID (Required for Web testing and web deployment)
# - Create an OAuth client ID with Application type: "Web application"
# - Authorized JavaScript origins:
#     http://localhost:8081
#     http://localhost:8082
# - Authorized redirect URIs:
#     http://localhost:8081
#     http://localhost:8082
#     https://auth.expo.io/@<expo-username>/vertifarm (if using Expo Auth Proxy)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# 2. iOS Client ID (Required for standalone iOS build)
# - Create an OAuth client ID with Application type: "iOS"
# - Bundle ID: com.vertifarm.app (must match app.json ios.bundleIdentifier)
# - Scheme: vertifarm (configured in app.json)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# 3. Android Client ID (Required for standalone Android build)
# - Create an OAuth client ID with Application type: "Android"
# - Package name: com.vertifarm.app (must match app.json android.package)
# - SHA-1 certificate fingerprint:
#     From local debug keystore: keytool -list -v -keystore ~/.android/debug.keystore -alias androiddebugkey -storepass android -keypass android
#     Or from EAS credentials: eas credentials
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# 4. Universal Fallback Client ID (Optional)
# - Fallback client ID if platform-specific ID is omitted
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
