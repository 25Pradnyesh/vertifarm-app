# VertiFarm Environment Variables
# Copy to .env or .env.local to configure

# API Configuration
EXPO_PUBLIC_API_URL=

# Google OAuth Configuration
# Obtain these client IDs from Google Cloud Console: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
