{
  "expo": {
    "name": "VertiFarm",
    "slug": "vertifarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "vertifarm",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vertifarm.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B3B2B",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.vertifarm.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#DC2626"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B3B2B",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
